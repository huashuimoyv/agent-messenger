{
  "name": "agent-messenger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless local agent messaging over MCP stdio",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "bin": {
    "agent-messenger": "./scripts/cli.mjs"
  },
  "keywords": [
    "mcp",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./plugins/pi/agent-messenger.ts"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "setup": "node scripts/install.mjs",
    "doctor": "node scripts/install.mjs --check",
    "dashboard": "node --disable-warning=ExperimentalWarning scripts/dashboard.mjs",
    "start": "node --disable-warning=ExperimentalWarning src/server.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "check-upstream": "node scripts/check-upstream.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "fzstd": "0.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
